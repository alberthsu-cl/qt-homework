# =============================================================================
#  qt-homework - study materials and sample code
#  Windows / MSVC / Qt6 / QML
#
#  Rule of thumb: if a build or a deploy script can regenerate it, it does not
#  belong here. Source, project files, docs and screenshots do.
# =============================================================================

# -----------------------------------------------------------------------------
#  Binaries - the important one
# -----------------------------------------------------------------------------
# Deployed Qt/MSVC runtimes and any vendor DLL are large, rebuildable, and in
# some cases not ours to publish. Keep them out of a public repo on purpose.
# If a sample genuinely needs a committed binary, override per file:
#     git add -f path/to/thing.dll
*.dll
*.exe
*.lib
*.obj
*.o
*.pdb
*.ilk
*.exp
*.idb
*.res

# The homework intentionally carries a self-contained QtKit runtime. Keep the
# general binary rule above, but allow only this explicitly scoped bundle.
!QtKit/runtime/**/*.dll

# Per-user ColorPicker preset persistence.
color_picker_demo/custom_colors.txt

# -----------------------------------------------------------------------------
#  Build output directories
# -----------------------------------------------------------------------------
bin/
bin_x64/
build/
build-*/
out/
x64/
Win32/
ARM64/
[Dd]ebug/
[Rr]elease/
[Dd]ebug_x64/
[Rr]elease_x64/
cmake-build-*/

# -----------------------------------------------------------------------------
#  Visual Studio
# -----------------------------------------------------------------------------
.vs/
*.user
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.aps
*.ncb
ipch/
*.ipch
# VS drops this while IntelliSense parses an open file; it reappears on its own.
enc_temp_folder/

# MSBuild intermediates
*.tlog
*.lastbuildstate
*.unsuccessfulbuild
*.log

# -----------------------------------------------------------------------------
#  Qt - generated by moc / uic / rcc
# -----------------------------------------------------------------------------
moc_*.cpp
moc_*.h
moc_predefs.h
qrc_*.cpp
ui_*.h
*.moc
*.rcc

# QML / JS bytecode cache
*.qmlc
*.jsc
.qmlls.ini

# qmake
*.pro.user
*.pro.user.*
.qmake.stash
.qmake.cache
Makefile
Makefile.[Dd]ebug
Makefile.[Rr]elease

# Qt Creator / CMake per-user
CMakeLists.txt.user
CMakeLists.txt.user.*

# -----------------------------------------------------------------------------
#  CMake
# -----------------------------------------------------------------------------
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
CTestTestfile.cmake
install_manifest.txt
_deps/
compile_commands.json

# -----------------------------------------------------------------------------
#  Editors
# -----------------------------------------------------------------------------
.idea/
*.swp
*.swo
*~
*.bak
*.orig
*.rej

# VS Code: keep shared config, drop personal state.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json

# -----------------------------------------------------------------------------
#  OS noise
# -----------------------------------------------------------------------------
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/
.DS_Store

# -----------------------------------------------------------------------------
#  Credentials - nothing here should ever be committed
# -----------------------------------------------------------------------------
.env
.env.*
*.pem
*.key
*.pfx
secrets.*

# -----------------------------------------------------------------------------
#  Archives - usually a staged runtime someone zipped up
# -----------------------------------------------------------------------------
*.zip
*.7z
*.rar
*.tar.gz

# =============================================================================
#  Deliberately NOT ignored, so study material survives:
#    *.png  *.jpg  *.gif   - screenshots and diagrams
#    *.md   *.html          - notes and write-ups
#    *.qml  *.qrc  *.js     - QML sources
#    *.cpp  *.h             - C++ sources
#    *.vcxproj  *.vcxproj.filters  *.pro  *.sln  CMakeLists.txt
#    *.ps1                  - staging/build scripts
# =============================================================================
