<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{3F1C8A21-6D4E-4B77-9C0A-5E2B7A9D1C34}</ProjectGuid>
    <RootNamespace>QmlColorPiker</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <Keyword>MFCProj</Keyword>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <!-- QtKit.dll exposes std::string in its ABI and is built with the release
         MSVC runtime. Keep symbols and disabled optimization in this config,
         but use the same runtime and STL ABI as QtKit. -->
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
    <UseOfMfc>Dynamic</UseOfMfc>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v143</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
    <UseOfMfc>Dynamic</UseOfMfc>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>

  <!-- Self-contained output. The .exe must sit beside QtKit.dll, the Qt6 DLLs
       and platforms\qwindows.dll for the DLL search path to resolve - but that
       does NOT have to be the product folder. Run stage_runtime.ps1 once to
       populate this directory with the minimum runtime set, and the demo runs
       from its own tree without touching bin_x64\PowerDirector. -->
  <PropertyGroup>
    <OutDir>$(ProjectDir)bin_x64\</OutDir>
    <IntDir>$(ProjectDir)build\QmlColorPiker\$(Configuration)\</IntDir>
    <TargetName>QmlColorPiker</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <LanguageStandard>stdcpp17</LanguageStandard>
      <PrecompiledHeader>Use</PrecompiledHeader>
      <PrecompiledHeaderFile>pch.h</PrecompiledHeaderFile>
      <!-- $(ProjectDir)..\..\src makes "external include/QtKit/Interface.h" resolve -->
      <AdditionalIncludeDirectories>$(ProjectDir)src;$(ProjectDir)..\..\src;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <PreprocessorDefinitions>WIN32;_WINDOWS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- /MP needs /Zi (not /ZI) and the serialising /FS, or parallel cl.exe
           instances fight over vc143.pdb (error C1041). -->
      <DebugInformationFormat>ProgramDatabase</DebugInformationFormat>
      <MinimalRebuild>false</MinimalRebuild>
      <AdditionalOptions>/FS %(AdditionalOptions)</AdditionalOptions>
      <WarningLevel>Level3</WarningLevel>
      <ConformanceMode>true</ConformanceMode>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>

  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>Disabled</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <Optimization>MaxSpeed</Optimization>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
    </ClCompile>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="src\pch.cpp">
      <PrecompiledHeader>Create</PrecompiledHeader>
    </ClCompile>
    <ClCompile Include="src\DemoApp.cpp" />
    <ClCompile Include="src\MainFrame.cpp" />
    <ClCompile Include="src\ColorPickerViewController.cpp" />
    <ClCompile Include="src\DemoController.cpp" />
    <ClCompile Include="src\DemoViewController.cpp" />
    <ClCompile Include="src\QtKitHost.cpp" />
  </ItemGroup>

  <ItemGroup>
    <ClInclude Include="src\pch.h" />
    <ClInclude Include="src\MainFrame.h" />
    <ClInclude Include="src\ColorPickerViewController.h" />
    <ClInclude Include="src\QtKitHost.h" />
    <ClInclude Include="src\DemoNames.h" />
    <ClInclude Include="src\DemoController.h" />
    <ClInclude Include="src\DemoViewController.h" />
  </ItemGroup>

  <ItemGroup>
    <None Include="qml\ColorPickerDialog.qml" />
    <None Include="qml\ColorPickerProperty.qml" />
    <None Include="qml\DemoImageButton.qml" />
    <None Include="qml\DemoWindow.qml" />
    <None Include="qml\DemoName.qml" />
    <None Include="qml\DemoProperty.qml" />
    <None Include="qml\DemoTintEffect.qml" />
    <None Include="qml\qmldir" />
    <None Include="README.md" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets" />
</Project>
